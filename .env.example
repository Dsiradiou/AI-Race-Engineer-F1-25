# Copier ce fichier en .env et adapter les valeurs. Ne jamais commiter .env.

# Télémétrie F1 25 (Paramètres du jeu → Télémétrie → UDP)
UDP_HOST=127.0.0.1
UDP_PORT=20777

# LLM local (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Reconnaissance vocale (Whisper)
WHISPER_MODEL=small

# TTS ElevenLabs (optionnel, laisser vide pour utiliser le TTS local)
ELEVENLABS_API_KEY=
